{
  "manifest_version": 3,
  "name": "HUD",
  "version": "1.0.0",
  "permissions": ["storage", "sidePanel", "tabs"],
  "action": {
    "default_title": "Click to open panel"
  },
  "background": {
    "service_worker": "src/background.ts"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"]
    }
  ],
  "side_panel": {
    "default_path": "index.html",
    "open_at_install": true
  },
  "icons": {
    "16": "icon_16px.png",
    "32": "icon_32px.png",
    "48": "icon_48px.png",
    "128": "icon_128px.png"
  }
}
