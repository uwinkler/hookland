{
  "manifest_version": 3,
  "name": "Captn",
  "version": "1.0.4",
  "permissions": ["storage", "sidePanel", "tabs"],
  "action": {
    "default_title": "Click to open panel"
  },
  "background": {
    "service_worker": "src/background.ts"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"]
    }
  ],
  "side_panel": {
    "default_path": "index.html",
    "open_at_install": true
  },
  "icons": {
    "16": "calculator_logo_16px.png",
    "32": "calculator_logo_32px.png",
    "48": "calculator_logo_48px.png",
    "128": "calculator_logo_128px.png"
  }
}
